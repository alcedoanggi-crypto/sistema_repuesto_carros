# Puerto de la API
PORT=4600
# Clave para firmar los tokens JWT (cámbiala en producción)
JWT_SECRET=cambia-esta-clave-larga-y-secreta
# Conexión a PostgreSQL / Supabase. Si se deja vacío, se usa PGlite (archivo local ./data)
# Supabase: Project Settings > Database > Connection string (URI)
DATABASE_URL=
# URL pública del frontend (CORS y sitemap)
PUBLIC_URL=http://localhost:5180
